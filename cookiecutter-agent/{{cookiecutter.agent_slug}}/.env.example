AGENT_NAME={{cookiecutter.agent_slug}}
LOG_LEVEL=INFO
ENVIRONMENT=development

# Shared Redis Streams bus (same Redis NestJS uses when AGENT_EVENTS_ENABLED=true)
EVENT_BUS_URL=redis://localhost:6379/0
AGENT_EVENTS_STREAM=agent:events
# AGENT_CONSUMER_GROUP=cg:{{cookiecutter.agent_slug}}
# AGENT_STREAM_MAXLEN=100000
# AGENT_MAX_DELIVERIES=5
# AGENT_EVENTS_DLQ_STREAM=agent:events:dlq

# NestJS HTTP bridge — BACKEND_API_TOKEN must match Nest AGENT_API_TOKEN
BACKEND_BASE_URL=
BACKEND_API_TOKEN=
# BACKEND_TIMEOUT_SECONDS=10

# Reliability / audit
# HANDLER_MAX_ATTEMPTS=3
# DEDUP_MAX_SIZE=10000
# AUDIT_MAX_RECORDS=1000

HEALTH_PORT=8080
