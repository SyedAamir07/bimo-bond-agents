AGENT_NAME=camera_agent
LOG_LEVEL=INFO
ENVIRONMENT=development

# Shared Redis Streams bus (same Redis the NestJS backend fans out onto).
# Use redis://<host>:<port>/<db> in production; memory://local for
# offline/unit-test runs (no Redis required).
EVENT_BUS_URL=redis://localhost:6380/0
AGENT_EVENTS_STREAM=agent:events
AGENT_CONSUMER_GROUP=cg:camera_agent
AGENT_STREAM_MAXLEN=100000
AGENT_MAX_DELIVERIES=5
AGENT_EVENTS_DLQ_STREAM=agent:events:dlq

# NestJS HTTP bridge -- REQUIRED for this agent (not optional): the
# approved feature/filter/effect catalog is fetched from
# GET /camera-studio/catalog, not hardcoded here. Must match the
# backend's AGENT_API_TOKEN (backend/.env: AGENT_API_TOKEN=...).
BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_TOKEN=CHANGE_ME_SET_SAME_VALUE_AS_BACKEND_AGENT_API_TOKEN

# Local run: distinct per agent so multiple agents can run on one host
# at once. Inside Docker Compose this is overridden to 8080
# (container-internal) and mapped to host 8081 -- see
# docker-compose.yml's camera_agent service.
HEALTH_PORT=8081

# --- Camera Agent specific ---
# How long a fetched catalog is trusted before re-fetching from the
# backend. Keeps every feature-toggle request from making an HTTP call.
CATALOG_CACHE_TTL_SECONDS=60
