AGENT_NAME=live_auction_agent
LOG_LEVEL=INFO
ENVIRONMENT=development

# Shared Redis Streams bus (same Redis the NestJS backend fans out onto).
# Use redis://<host>:<port>/<db> in production; memory://local for
# offline/unit-test runs (no Redis required).
EVENT_BUS_URL=redis://localhost:6380/0
AGENT_EVENTS_STREAM=agent:events
AGENT_CONSUMER_GROUP=cg:live_auction_agent
AGENT_STREAM_MAXLEN=100000
AGENT_MAX_DELIVERIES=5
AGENT_EVENTS_DLQ_STREAM=agent:events:dlq

# NestJS HTTP bridge -- must match the backend's AGENT_API_TOKEN
# (backend/.env: AGENT_API_TOKEN=...). Leave BACKEND_BASE_URL empty to
# run with the HTTP bridge disabled (event-bus-only mode).
BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_TOKEN=CHANGE_ME_SET_SAME_VALUE_AS_BACKEND_AGENT_API_TOKEN

# Local run: use 8085 to avoid clashing with other agents' local
# HEALTH_PORT bindings. Inside Docker Compose, this is overridden back
# to 8080 (container-internal) and mapped to host 8085 — see
# docker-compose.yml's live_auction_agent service.
HEALTH_PORT=8085

# --- Live Auction Agent specific ---
# Tie-break policy passed to foundation.auction_rules.resolve_purchase_eligibility.
# "earliest": earliest contribution among tied leaders wins automatically.
# "explicit": ties are flagged for human/product resolution instead of
# being auto-resolved (see project doc: "Clarify how gifts relate to
# bids and purchase eligibility before approving the calculation process").
AUCTION_TIE_BREAK_POLICY=earliest
