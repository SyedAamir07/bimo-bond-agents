AGENT_NAME=live_streaming_agent
LOG_LEVEL=INFO
ENVIRONMENT=development

# Shared Redis Streams bus (same Redis the NestJS backend fans out onto).
# Use redis://<host>:<port>/<db> in production; memory://local for
# offline/unit-test runs (no Redis required).
EVENT_BUS_URL=redis://localhost:6380/0
AGENT_EVENTS_STREAM=agent:events
AGENT_CONSUMER_GROUP=cg:live_streaming_agent
AGENT_STREAM_MAXLEN=100000
AGENT_MAX_DELIVERIES=5
AGENT_EVENTS_DLQ_STREAM=agent:events:dlq

# NestJS HTTP bridge -- must match the backend's AGENT_API_TOKEN
# (backend/.env: AGENT_API_TOKEN=...). Leave BACKEND_BASE_URL empty to
# run with the HTTP bridge disabled (event-bus-only mode).
BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_TOKEN=CHANGE_ME_SET_SAME_VALUE_AS_BACKEND_AGENT_API_TOKEN

# Local run: distinct per agent so multiple agents can run on one host
# at once. Inside Docker Compose this is overridden to 8080
# (container-internal) and mapped to host 8082 -- see
# docker-compose.yml's live_streaming_agent service.
HEALTH_PORT=8082

# --- Live Streaming Agent specific ---
# Reconnection policy: how many times to retry before giving up on a
# session, and how long without a heartbeat before a session is
# considered stalled (interrupted) even without an explicit event.
MAX_RECONNECT_ATTEMPTS=3
HEARTBEAT_STALE_SECONDS=45
STALE_SWEEP_INTERVAL_SECONDS=10

# --- ML anomaly detection (advisory early-warning layer; see anomaly_model.py) ---
# Minimum completed sessions before the IsolationForest model trains for
# the first time. Before this, predictions fall back to "never anomalous"
# (never guesses) -- see anomaly_model.py's predict() docstring.
ML_MIN_TRAINING_SAMPLES=30
# Retrain after this many new completed sessions since the last training run.
ML_RETRAIN_INTERVAL_SAMPLES=20
# "auto" lets scikit-learn derive the anomaly threshold from the
# training data's own spread (recommended -- see config.py for why a
# fixed fraction caused both false positives and false negatives in
# manual testing). Set a fixed 0.0-0.5 fraction only if you have a
# specific, measured reason to override auto.
ML_CONTAMINATION=auto
