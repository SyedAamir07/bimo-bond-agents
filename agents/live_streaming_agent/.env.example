AGENT_NAME=live_streaming_agent
LOG_LEVEL=INFO
ENVIRONMENT=development

# Shared Redis Streams bus (same Redis the NestJS backend fans out onto).
# Use redis://<host>:<port>/<db> in production; memory://local for
# offline/unit-test runs (no Redis required).
EVENT_BUS_URL=redis://localhost:6380/0
AGENT_EVENTS_STREAM=agent:events
AGENT_CONSUMER_GROUP=cg:live_streaming_agent
AGENT_STREAM_MAXLEN=100000
AGENT_MAX_DELIVERIES=5
AGENT_EVENTS_DLQ_STREAM=agent:events:dlq

# NestJS HTTP bridge -- must match the backend's AGENT_API_TOKEN
# (backend/.env: AGENT_API_TOKEN=...). Leave BACKEND_BASE_URL empty to
# run with the HTTP bridge disabled (event-bus-only mode).
BACKEND_BASE_URL=http://localhost:3000
BACKEND_API_TOKEN=CHANGE_ME_SET_SAME_VALUE_AS_BACKEND_AGENT_API_TOKEN

HEALTH_PORT=8082

# --- Live Streaming Agent specific ---
# Reconnection policy: how many times to retry before giving up on a
# session, and how long without a heartbeat before a session is
# considered stalled (interrupted) even without an explicit event.
MAX_RECONNECT_ATTEMPTS=3
HEARTBEAT_STALE_SECONDS=45
STALE_SWEEP_INTERVAL_SECONDS=10
